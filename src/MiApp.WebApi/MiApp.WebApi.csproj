<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Genera el XML con los comentarios /// para que Swagger los muestre -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no exigir comentario XML en cada miembro público -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Alinea todas las librerías Microsoft.IdentityModel.* en la misma versión (8.14.0) -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.14.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Timeout y reintentos para la llamada HTTP a PaymentService -->
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiApp.Application\MiApp.Application.csproj" />
    <ProjectReference Include="..\MiApp.Infrastructure\MiApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
